# ---- Database (Neon Postgres) ----
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ---- Auth ----
# REQUIRED. Passwordless magic-link sessions are signed with this. A production
# build refuses to boot if it's unset. Generate: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""
# Bootstrap allowlists (comma-separated) that grant admin/judge access by email.
ADMIN_EMAILS="you@example.com"
JUDGE_EMAILS="judge1@example.com,judge2@example.com"

# ---- Email (Resend) ----
RESEND_API_KEY=""
# Verifies inbound Resend delivery/open/click webhooks (Resend dashboard → Webhooks).
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Athens Holiday Market <hello@athensholidaymarket.com>"
# Where the public contact form delivers.
CONTACT_FORM_TO="you@example.com"

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Comma-separated phone numbers for the Text tab "Judges" option (public repo → env only).
JUDGE_PHONES=""

# ---- Uploads (Vercel Blob) ----
BLOB_READ_WRITE_TOKEN=""

# ---- PayPal booth-fee invoicing ----
PAYPAL_ENV="sandbox"          # "sandbox" (default) or "live"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ---- AI proofreading (optional, application form) ----
ANTHROPIC_API_KEY=""

# ---- Artist scouting: auto-scout discovery search ----
# Perplexity Sonar is the preferred discovery provider (no web-search cap).
# If unset, auto-scout falls back to Anthropic web search (ANTHROPIC_API_KEY),
# which has a tighter account-level usage limit.
PERPLEXITY_API_KEY=""

# ---- Cron ----
# Authorizes the daily cron route; Vercel sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=""

# ---- Icons (build-time) ----
# Central Icons license key — required at `npm install` time.
CENTRAL_LICENSE_KEY=""

# ---- Public ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Optional integrations ----
# Social-kit reminder recipients for the NPR flagpole + posting team.
NPR_REMINDER_EMAIL=""
NPR_REMINDER_PHONE=""
SOCIAL_POSTING_TEAM=""

# ---- Local dev only (NEVER set in production) ----
# Sign in to /admin as an admin without email. Hard-gated to non-production.
# ADMIN_DEV_BYPASS="1"
# ADMIN_DEV_EMAIL="you@example.com"
