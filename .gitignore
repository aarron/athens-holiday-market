# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw source assets (optimized copies go to Blob/public)
/assets

# drizzle (keep migrations; ignore studio cache)
/drizzle/meta/_journal.bak
scripts/data/

# Claude Code local settings
.claude/settings.local.json

# Downloaded past-application photos — migrated to Vercel Blob, never commit (privacy + size)
public/photos/backfill/
CODE-REVIEW-REMEDIATION-PROMPT.md
